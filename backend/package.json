{
  "name": "backend-bun-hono",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build index.ts --target bun --outdir dist",
    "memory:cron": "bun run src/scripts/memory-score-cron.ts"
  },
  "dependencies": {
    "hono": "^4.9.4",
    "node-cron": "^4.2.1",
    "undici": "^7.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
